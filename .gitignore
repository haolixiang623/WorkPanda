# 操作系统 / 编辑器
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo

# 依赖目录
node_modules/
vendor/
__pycache__/
.venv/
venv/

# 构建产物
dist/
build/
out/
*.log

# 环境变量 / 密钥
.env
.env.local
.env.*.local

# 测试临时目录
.pytest-tmp/

# 本地存储
*.db
*.db-journal

# Octop 运行时工作区
.octop/

# Octop 插件 UI 是手写的自包含 ESM 源码（安装时不跑 npm build），不是构建产物，
# 必须纳入版本控制；上面的 dist/ 规则会误伤。
!plugins/workpanda-ops/ui/dist/
!plugins/workpanda-ops/ui/dist/*
