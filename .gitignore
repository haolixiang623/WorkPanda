# 操作系统 / 编辑器
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo

# 依赖目录
node_modules/
vendor/
__pycache__/
.venv/
venv/

# 构建产物
dist/
build/
out/
*.log

# 环境变量 / 密钥
.env
.env.local
.env.*.local

# 测试临时目录
.pytest-tmp/

# 本地存储
*.db
*.db-journal

# Octop 运行时工作区
.octop/

# Octop 插件 UI 是手写的自包含 ESM 源码（安装时不跑 npm build），不是构建产物，
# 必须纳入版本控制；上面的 dist/ 规则会误伤。
!plugins/workpanda-ops/ui/dist/
!plugins/workpanda-ops/ui/dist/*

# 管理侧配置台前端的编译产物随仓库交付（静态托管只需 index.html + dist/main.js），
# 安装时不跑 tsc；同样要排除 dist/ 规则的误伤。
!admin-ui/dist/
!admin-ui/dist/*

# 群众侧对话页的编译产物同样随仓库交付：服务端直接托管 `web/`，
# 没有构建步骤可用；`tests/test_web_ui.py` 还会比对源码与产物是否同步。
!web/dist/
!web/dist/*
